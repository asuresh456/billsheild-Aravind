GEMINI_API_KEY=add-your-key-locally
GEMINI_MODEL=gemini-3.5-flash-lite
# Supabase values are normally pulled from the linked Vercel project by `vercel dev`.
# The publishable key is safe for the browser only because every table has RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
